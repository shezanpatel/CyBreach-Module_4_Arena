APP_NAME=CyBreach Wallet Service
APP_VERSION=1.0.0

POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_password
POSTGRES_DB=wallet_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://wallet_user:wallet_password@localhost:5432/wallet_db

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Generate unique local values before starting the service. Delta's
# WALLET_SERVICE_JWT_SECRET must exactly match JWT_SECRET_KEY below.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
SERVICE_API_KEY=replace-with-a-long-random-service-api-key
