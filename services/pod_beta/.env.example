# Match the JWT signing secret and algorithm used by Pod Delta.
BETA_JWT_SECRET=replace-with-the-same-secret-as-Delta-SECRET_KEY
BETA_JWT_ALGORITHM=HS256

# Use "service" outside local demo/test runs. "mock" is a local-only fixture wallet.
BETA_WALLET_MODE=mock
WALLET_SERVICE_URL=http://127.0.0.1:8004
WALLET_SERVICE_JWT_SECRET=replace-with-Wallet-JWT_SECRET_KEY
WALLET_SERVICE_JWT_ALGORITHM=HS256
WALLET_SERVICE_API_KEY=replace-with-Wallet-SERVICE_API_KEY
ARENA_CREDIT_CURRENCY=CRD

# Engagement persistence and durable event delivery.
DATABASE_URL=sqlite:///./module4_arena.db
KAFKA_ENABLE=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
